server {
    listen 80;
    listen [::]:80;
    server_name my.avecrouge.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name my.avecrouge.com;

    ssl_certificate /etc/letsencrypt/live/my.avecrouge.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/my.avecrouge.com/privkey.pem;

    auth_basic "AveCove Private";
    auth_basic_user_file /etc/nginx/.htpasswd-avecove-media;

    client_max_body_size 64k;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
