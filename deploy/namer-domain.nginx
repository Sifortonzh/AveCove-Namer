# Independent entry; same loopback backend and private runtime data as /media-tools/.
server {
    listen 80;
    listen [::]:80;
    server_name namer.avecove.com;
    location ^~ /.well-known/acme-challenge/ {
        root /www/wwwroot/namer.avecove.com;
        default_type text/plain;
    }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    http2 on;
    server_name namer.avecove.com;
    ssl_certificate /etc/letsencrypt/live/namer.avecove.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/namer.avecove.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
